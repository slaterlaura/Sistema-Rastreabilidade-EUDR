# Nomes dos recursos no Azure. Veja docs/DEPLOY-AZURE.md, passo 2.
# O tutorial cria o .env.azure a partir deste arquivo: as senhas geradas entram no topo.
# NUNCA commite o .env.azure (já está no .gitignore).

# Troque "ls01" por algo seu (só letras minúsculas e números): servidor PostgreSQL,
# conta de armazenamento e Function App precisam de nomes únicos no Azure inteiro.
export SUFIXO=lslater26

export RG=rg-eudr
export LOCATION=brazilsouth
export PG_SERVER=pg-origemcheck-${SUFIXO}
export PG_ADMIN=eudradmin
export STORAGE=storigemcheck${SUFIXO}
export CONTAINER=origemcheck-arquivos
export APP=func-origemcheck-${SUFIXO}
export SWA=swa-origemcheck-${SUFIXO}

# Endereços (derivados dos nomes acima)
export PG_HOST=${PG_SERVER}.postgres.database.azure.com
# Repare: é DATABASE_URL_AZURE, não DATABASE_URL. Assim o backend local continua usando o banco local;
# quando um comando precisar do Azure, o tutorial passa a variável explicitamente.
export DATABASE_URL_AZURE="postgresql+psycopg2://${PG_ADMIN}:${PG_SENHA}@${PG_HOST}:5432/eudr?sslmode=require"
