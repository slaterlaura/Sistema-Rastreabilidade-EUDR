# Banco (docker compose). Da máquina o host é localhost:5433; dentro do Docker é db:5432.
POSTGRES_USER=eudr
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=eudr
POSTGRES_PORT=5433

# A senha aqui precisa ser a mesma de POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg2://eudr:troque-esta-senha@localhost:5433/eudr

# Autenticação: gere uma chave longa e aleatória (ex.: openssl rand -hex 32)
JWT_SECRET=troque-esta-chave

# R5: sobreposição abaixo disso (m²) não bloqueia a fazenda
TOLERANCIA_M2=1000

# Origens permitidas no CORS (separadas por vírgula)
CORS_ORIGENS=http://localhost:5173
